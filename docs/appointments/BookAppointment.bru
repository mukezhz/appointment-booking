meta {
  name: BookAppointment
  type: http
}

post {
  url: {{baseUrl}}/api/v1/appointments
  body: json {
    {
      "doctor_id": "{{doctorId}}",
      "appointment_date": "2025-06-20",
      "start_time": "09:00:00"
    }
  }
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

vars {
  doctorId: "uuid-goes-here"
}

tests {
  test("should book appointment") {
    const response = res;
    expect(response.status).toBe(201);
    expect(response.body.detail).toBe("Appointment booked successfully");
  }
}
