meta {
  name: CancelAppointment
  type: http
}

delete {
  url: {{baseUrl}}/api/v1/appointments/{{appointmentId}}
  body: json {
    {
      "reason": "Schedule conflict, need to reschedule"
    }
  }
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

vars {
  appointmentId: "uuid-goes-here"
}

tests {
  test("should cancel appointment") {
    const response = res;
    expect(response.status).toBe(200);
    expect(response.body.detail).toBe("Appointment cancelled successfully");
  }
}
