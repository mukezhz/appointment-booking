meta {
  name: CreateAvailability
  type: http
}

post {
  url: {{baseUrl}}/api/v1/availability
  body: json {
    {
      "day_of_week": 1,
      "start_time": "09:00:00",
      "end_time": "17:00:00",
      "slot_duration": 30,
      "is_recurring": true
    }
  }
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

tests {
  test("should create availability slot") {
    const response = res;
    expect(response.status).toBe(201);
    expect(response.body.detail).toBe("Availability slot created");
  }
}
