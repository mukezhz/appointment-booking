meta {
  name: UpdateAvailability
  type: http
}

put {
  url: {{baseUrl}}/api/v1/availability/{{availabilityId}}
  body: json {
    {
      "start_time": "10:00:00",
      "end_time": "18:00:00",
      "slot_duration": 45
    }
  }
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

vars {
  availabilityId: "uuid-goes-here"
}

tests {
  test("should update availability slot") {
    const response = res;
    expect(response.status).toBe(200);
    expect(response.body.detail).toBe("Availability slot updated");
  }
}
