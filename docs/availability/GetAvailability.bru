meta {
  name: Get Availability
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/api/v1/availability
  body: none
  auth: inherit
}

tests {
  test("should get availability list successfully", function() {
    const response = res;
    expect(response.status).to.equal(200);
    expect(response.body).to.be.an("array");
    if (response.body.length > 0) {
      expect(response.body[0]).to.have.property("uuid");
      expect(response.body[0]).to.have.property("weekday");
      expect(response.body[0]).to.have.property("start_time");
      expect(response.body[0]).to.have.property("end_time");
    }
  })
}

docs {
  title: "Get Availability"
  description: """
    Retrieves all availability slots for the authenticated doctor.
    
    ## Authentication
    Requires a valid JWT token in the Authorization header:
    `Authorization: Bearer <token>`
    
    ## Response Format
    ```json
    [
      {
        "uuid": "string",
        "weekday": "string",
        "start_time": "string",
        "end_time": "string"
      }
    ]
    ```
    
    ## Notes
    - Returns an array of availability slots
    - Only returns slots for the authenticated doctor
    - Times are in 24-hour format (HH:MM)
  """
}
